rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Phase 6 helpers ──────────────────────────────────────────────

    // Allowed forward transitions. Mirrors OrderStatus.allowedNext() in :domain.
    // CANCELLED only from pre-SHIPPED (PENDING/CONFIRMED).
    function allowedNext(current) {
      return current == 'PENDING'   ? ['CONFIRMED', 'CANCELLED']
           : current == 'CONFIRMED' ? ['SHIPPED', 'CANCELLED']
           : current == 'SHIPPED'   ? ['DELIVERED']
           : [];
    }

    function isSeller(sellerOrder) {
      return request.auth != null
          && request.auth.uid == sellerOrder.sellerId;
    }

    function immutableFieldsUnchanged() {
      return request.resource.data.sellerId      == resource.data.sellerId
          && request.resource.data.parentOrderId == resource.data.parentOrderId
          && request.resource.data.items         == resource.data.items
          && request.resource.data.subtotal      == resource.data.subtotal
          && request.resource.data.shippingShare == resource.data.shippingShare
          && request.resource.data.discountShare == resource.data.discountShare;
    }

    function appendedExactlyOneStatusEntry() {
      return request.resource.data.statusHistory.size()
           == resource.data.statusHistory.size() + 1
          && request.resource.data.statusHistory[resource.data.statusHistory.size()].status
           == request.resource.data.status;
    }

    // ── /sellerOrders/{id} ───────────────────────────────────────────
    // Create + delete are server-only (admin SDK bypasses these rules).
    // Updates allowed only by the owning seller, only along the
    // forward-only transition map, with immutable structural fields and
    // an exactly-one-entry append to statusHistory.
    match /sellerOrders/{sellerOrderId} {
      // Read: only the owning seller (sellerId) or the customer who placed the
      // parent order (denormalised userId — no get() needed, so it works in
      // list queries too). Clients must query with a matching sellerId or
      // userId equality filter, or Firestore rejects the whole query.
      allow read: if isSeller(resource.data)
                  || (request.auth != null
                      && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow delete: if false;
      allow update: if isSeller(resource.data)
                    && request.resource.data.status in allowedNext(resource.data.status)
                    && immutableFieldsUnchanged()
                    && appendedExactlyOneStatusEntry();
    }

    // Read: only the customer who owns the order. The My Orders query already
    // filters `where userId == uid`, so it stays compliant; single-doc reads
    // are ownership-checked. Writes stay server-only (fan-out via Admin SDK).
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ── /notifications/{uid}/items/{id} (Phase 8, D-01/D-06) ─────────────
    // Notification history docs are written server-only by the push-dispatching
    // Cloud Functions (Admin SDK bypasses these rules). Clients may:
    //   - read ONLY their own notifications (T-08-02: no cross-user reads);
    //   - update ONLY the `read` flag for mark-as-read (T-08-03: the
    //     diff(...).hasOnly(['read']) restriction blocks mutating title/body/
    //     deep-link fields).
    // Client create/delete are denied (T-08-01: no forging fake notifications).
    match /notifications/{userId}/items/{notifId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // Server-only: written by createPaymentIntent and consumed by the Stripe
    // webhook (both via the Admin SDK, which bypasses these rules). Clients
    // must never read or write pending-payment order payloads.
    match /checkoutSessions/{sessionId} {
      allow read, write: if false;
    }

    // ── PRE-PHASE-6 COLLECTIONS ─────────────────────────────────────────
    // Phase 6 was the FIRST phase to ship firestore.rules. Before this,
    // the database ran on Console default rules (open to authenticated
    // users). When this file deployed it overrode those defaults and
    // implicitly denied all reads/writes to USERS, PRODUCTS, CATEGORIES,
    // TAGS, discountCodes — breaking sign-up, login, product browse, etc.
    //
    // This block restores the pre-Phase-6 behavior so existing features
    // keep working. Tighten per-collection in a follow-up housekeeping
    // pass (e.g. PRODUCTS read public, write seller-only; USERS read/write
    // own doc only; etc.).
    match /USERS/{userId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /PRODUCTS/{productId} {
      // Product top-level doc stays client-writable for seller product
      // management (assumption A1). The rating aggregate fields
      // (averageRating / reviewCount) are recomputed server-side by the
      // submitReview callable; any client set is overwritten on next recompute.
      allow read, write: if request.auth != null;

      // ── Reviews (Phase 7) ──────────────────────────────────────────────
      // Reads stay open to authenticated users (reviews are public product
      // content — D-02). ALL writes are server-only: the submitReview /
      // markReviewHelpful / setReviewVisibility callables use the Admin SDK,
      // which bypasses these rules. This locks out fake verified-purchase
      // reviews, direct edits/deletes, and helpful-vote ballot stuffing.
      match /REVIEWS/{reviewId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;

        match /helpfulVotes/{voterId} {
          allow read: if request.auth != null;
          allow create, update, delete: if false;
        }
      }
    }
    match /CATEGORIES/{categoryId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /TAGS/{tagId} {
      allow read, write: if request.auth != null;
    }
    match /discountCodes/{codeId} {
      allow read, write: if request.auth != null;
    }
  }
}
