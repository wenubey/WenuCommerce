{
  "name": "wenucommerce-functions",
  "description": "Firebase Cloud Functions for WenuCommerce",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint --ext .js,.ts .",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore \"jest --testPathPattern=rules\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.12",
    "@types/sinon": "^17.0.3",
    "firebase-functions-test": "latest",
    "firebase-tools": "^13.29.0",
    "jest": "^29.7.0",
    "sinon": "^19.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "private": true
}
